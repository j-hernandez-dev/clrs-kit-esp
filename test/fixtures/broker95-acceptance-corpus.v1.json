  "executionScenarios": [
    {
      "id": "execution-increment",
      "sourceCode": "PRINCIPAL()\n    valor = 0\n    leer valor\n    escribir valor + 1",
      "expectedStatus": "completed",
      "testCases": [
        { "id": "EXEC-1", "kind": "normal", "requirementIds": ["REQ-1"], "stdin": "4\n", "expected": "5\n", "comparison": "exact", "timeoutMs": 1000 },
        { "id": "EXEC-2", "kind": "boundary", "requirementIds": ["REQ-1"], "stdin": "-1\n", "expected": "0\n", "comparison": "exact", "timeoutMs": 1000 },
        { "id": "EXEC-3", "kind": "normal", "requirementIds": ["REQ-1"], "stdin": "41\n", "expected": "42\n", "comparison": "number", "timeoutMs": 1000 }
      ],
      "expectedSummary": { "total": 3, "passed": 3, "failed": 0, "runtimeErrors": 0, "timedOut": 0, "outputLimited": 0, "startFailed": 0, "invalid": 0, "notRun": 0 }
    },
    {
