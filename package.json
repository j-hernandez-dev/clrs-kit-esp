{
  "name": "clrs-kit-esp",
  "displayName": "CLRS Kit Español",
  "description": "Soporte de lenguaje y herramientas para el lenguaje de pseudocódigo CLRS.",
  "version": "1.3.2",
  "publisher": "j-hernandez-dev",
  "icon": "./extension/images/icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Language Packs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/j-hernandez-dev/clrs-kit-esp.git"
  },
  "activationEvents": [
    "onLanguage:clrs-es",
    "onCommand:CLRS.runCode",
    "onCommand:CLRS.copyCostExpression",
    "onCommand:CLRS.toggleCost",
    "onCommand:CLRS.generateCodeDiagram",
    "onCommand:CLRS.generateCode",
    "onCommand:CLRS.toggleDiagram",
    "onCommand:CLRS.exportSVG"
  ],
  "main": "./extension/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[clrs-es]": {
        "editor.detectIndentation": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "CLRS.runCode",
          "group": "navigation@1",
          "when": "resourceLangId == clrs-es"
        },
        {
          "command": "CLRS.toggleCost",
          "group": "navigation@2",
          "when": "resourceLangId == clrs-es"
        },
        {
          "command": "CLRS.toggleDiagram",
          "group": "navigation@3",
          "when": "resourceLangId == clrs-es"
        },
        {
          "command": "CLRS.generateCode",
          "group": "navigation@4",
          "when": "resourceLangId == clrs-es"
        },
        {
          "command": "CLRS.exportSVG",
          "group": "navigation@5",
          "when": "resourceLangId == clrs-es"
        }
      ]
    },
    "commands": [
      {
        "command": "CLRS.runCode",
        "title": "Ejecutar código CLRS",
        "icon": "$(play)"
      },
      {
        "command": "CLRS.toggleCost",
        "title": "Mostrar/ocultar costo algorítmico",
        "icon": "$(graph)"
      },
      {
        "command": "CLRS.toggleDiagram",
        "title": "Mostrar diagrama de flujo",
        "icon": "$(type-hierarchy-sub)"
      },
      {
        "command": "CLRS.generateCode",
        "title": "Generar código JavaScript",
        "icon": "$(file-code)"
      },
      {
        "command": "CLRS.exportSVG",
        "title": "Exportar diagrama de flujo SVG",
        "icon": "$(file-media)"
      }
    ],
    "languages": [
      {
        "id": "clrs-es",
        "aliases": [
          "CLRS Español",
          "clrs-es"
        ],
        "extensions": [
          ".clrs"
        ],
        "configuration": "./extension/language-config/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "clrs-es",
        "scopeName": "source.clrs-es",
        "path": "./extension/syntaxes/clrs.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "clrs-es",
        "path": "./extension/snippets/clrs-core.code-snippets"
      },
      {
        "language": "clrs-es",
        "path": "./extension/snippets/clrs-math.code-snippets"
      },
      {
        "language": "clrs-es",
        "path": "./extension/snippets/clrs-file.code-snippets"
      },
      {
        "language": "clrs-es",
        "path": "./extension/snippets/clrs-string.code-snippets"
      },
      {
        "language": "clrs-es",
        "path": "./extension/snippets/clrs-array.code-snippets"
      },
      {
        "language": "clrs-es",
        "path": "./extension/snippets/clrs-type.code-snippets"
      },
      {
        "language": "clrs-es",
        "path": "./extension/snippets/clrs-error.code-snippets"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "npm run test:extension",
    "test:unit": "node --test test/frontend.characterization.test.js test/ast.validation.test.js test/ast.consumers.test.js test/ast.visitor.test.js test/cost.algebra.test.js test/cost.presentation.test.js test/standard.library.catalog.test.js test/iteration.analysis.test.js test/asymptotic.analysis.test.js test/recurrence.analysis.test.js test/transpiler.characterization.test.js test/transpiler.visitors.test.js test/pipeline.characterization.test.js test/compilation.service.test.js test/semantic.analysis.test.js test/language.diagnostics.test.js test/static.diagnostics.provider.test.js test/error.localization.test.js test/diagram.characterization.test.js test/diagram.visitors.test.js test/diagram.application.test.js test/diagram.themes.test.js test/svg.export.test.js test/application.controllers.test.js test/application.composition.test.js",
    "test:extension": "vscode-test",
    "build:webview": "npm --prefix flow run build",
    "test:all": "npm run lint && npm run test:unit && npm run build:webview && npm run test:extension",
    "release:check": "npm run test:all",
    "prepackage:vsix": "npm run release:check",
    "package:vsix": "node scripts/package-vsix.mjs",
    "package:list": "vsce ls"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.3"
  },
  "dependencies": {
    "chevrotain": "^12.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-2.0-only",
  "type": "module"
}
